{
  "name": "vuetreez",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "bunx --bun vite --host",
    "build": "vue-tsc && vite build",
