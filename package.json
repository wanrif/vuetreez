    "pinia": "^3.0.4",
    "pinia-plugin-persistedstate": "^4.7.1",
    "vue": "^3.5.29",
    "vue-i18n": "^11.2.8",
    "vue-router": "^5.0.3",
    "wrangler": "^4.69.0",
    "zipson": "^0.2.12"
  },
  "devDependencies": {
    "@types/bun": "^1.3.9",
    "@types/lodash": "^4.17.24",
    "@types/node": "^24.11.0",
    "@vitejs/plugin-vue": "^6.0.4",
    "autoprefixer": "^10.4.27",
    "oxlint": "^1.50.0",
